<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#202b28">
<meta name="description" content="강호십존 — 닫힌 문을 열고 장서각의 천하십존록을 펼치다.">
<title>강호십존 · 장서각 — 천하십존록</title>
<style>@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700&display=swap');

:root{--ink:#182020;--paper:#f2e4c8;--muted:#c7b9a1;--brass:#b99a63;--red:#a44940}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#151b1d;font-family:'Noto Serif KR','Apple SD Gothic Neo','Malgun Gothic',serif;-webkit-font-smoothing:antialiased}button{font:inherit;cursor:pointer}button:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid #ffe7a4;outline-offset:4px}button:disabled{cursor:default}#experience{position:relative;height:100vh;height:100dvh;width:100%;overflow:hidden;color:#fff}
/* ENTER THROUGH A SINGLE, LAYERED ENVIRONMENT */
.arrival{position:absolute;inset:0;z-index:3;overflow:hidden;background:#637d80;transition:opacity .55s ease,visibility .55s}.arrival.leaving{opacity:0;visibility:hidden;pointer-events:none}.cinema{position:absolute;inset:0;overflow:hidden;--walk-bob:0px;transform:translateY(var(--walk-bob));pointer-events:none}.courtyard-art{position:absolute;inset:-6%;background:url("data:image/webp;base64,") center 49%/cover no-repeat;transform-origin:50% 57%;will-change:transform}.floor-plane{position:absolute;left:-28%;right:-28%;bottom:-16%;height:45%;background:url("data:image/webp;base64,") center/100% 100%;transform-origin:50% 100%;opacity:0;will-change:transform,opacity}.gate-art{position:absolute;left:50%;top:50%;width:max(100vw,234.025vh);height:max(42.73vw,100vh);transform:translate(-50%,-50%);transform-origin:50% 53%;perspective:1400px;transform-style:preserve-3d;will-change:transform,opacity}.gate-frame{width:100%;height:100%;object-fit:fill;position:absolute;inset:0;z-index:2}.door{position:absolute;z-index:4;top:35.3%;width:17.25%;height:49.8%;transform-style:preserve-3d;backface-visibility:hidden;will-change:transform;filter:drop-shadow(0 2px 9px #10191d66)}.door img{width:100%;height:100%;display:block}.door.left{left:32.48%;transform-origin:0% 50%}.door.right{left:49.72%;transform-origin:100% 50%}.glimmer{position:absolute;z-index:5;top:60.8%;width:9px;height:9px;border-radius:50%;background:#fff4c7;box-shadow:0 0 10px 4px #ffe99a,0 0 20px 7px #ffd56b;opacity:0;animation:blink 5.6s ease-in-out infinite}.glimmer-left{left:46.2%}.glimmer-right{left:53.3%;animation-delay:.4s}.glimmer:before,.glimmer:after{content:"";position:absolute;background:#fff2c6;left:50%;top:50%;transform:translate(-50%,-50%)}.glimmer:before{width:2px;height:22px}.glimmer:after{height:2px;width:22px}@keyframes blink{0%,12%,24%,100%{opacity:0;transform:scale(.4)}16%,20%{opacity:.86;transform:scale(.85)}}.enter-hit{position:absolute;inset:0;z-index:8;border:0;width:100%;height:100%;background:none;cursor:pointer}.enter-hit:disabled{pointer-events:none}.inner-view{position:absolute;inset:0;z-index:1;clip-path:inset(42% 46% 38% 46%);opacity:0;will-change:clip-path,opacity}.inside-image{position:absolute;inset:0;background:url("data:image/webp;base64,") center/cover no-repeat;filter:brightness(.8)}.jamb{position:absolute;z-index:2;opacity:0;pointer-events:none}.jamb-left,.jamb-right{top:-6%;bottom:-6%;width:clamp(32px,8vw,125px);background:linear-gradient(90deg,#261b1a,#91613f 22%,#302220 48%,#1a1517);box-shadow:0 0 20px #0e1118b5;will-change:transform,opacity}.jamb-left{left:calc(50% - 8vw)}.jamb-right{left:calc(50% + 8vw)}.jamb-top{left:0;right:0;top:0;height:15%;background:linear-gradient(#15191b,#473129 70%,#845c43 92%,transparent)}.cinema-grade{position:absolute;inset:0;z-index:6;background:linear-gradient(90deg,#0c1a2014,transparent 24%,transparent 76%,#11182018);pointer-events:none}

/* DESIGN SYSTEM — Work research: ink, quiet paper, measured typography */

:root{--slate:#1b2624;--slate2:#25312d;--silk:#f5f3ec;--paper:#f4f1e9;--ink:#202725;--fog:#a7b2a8;--rust:#af6651;--border:#d7dcd4;--ui:'Pretendard','Apple SD Gothic Neo','Malgun Gothic',sans-serif;--serif:'Noto Serif KR','Noto Serif CJK KR','Nanum Myeongjo',serif}
html,body{font-family:var(--ui);background:#0e1413;color:#e9eee9}
button,a{touch-action:manipulation}
button:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid #a2c9c2;outline-offset:3px}
#experience{background:#121a19}
.arrival{z-index:5}.skip-entry{position:absolute;right:20px;bottom:max(24px,env(safe-area-inset-bottom));z-index:9;border:1px solid #d6d4c4aa;background:#182220cc;color:#f5efe4;padding:11px 20px;font-size:13px;letter-spacing:.04em;backdrop-filter:blur(6px)}.skip-entry[hidden]{display:none}.skip-entry span{margin-left:12px}
/* The archive retains the original full-size illustration. No fake scrolls in that image. */
.library{position:absolute;inset:0;opacity:0;visibility:hidden;z-index:2;overflow:auto;overscroll-behavior:contain;background:#151d1b;transition:opacity .48s ease,visibility .48s ease}
.library.visible{opacity:1;visibility:visible}.library-art{position:fixed;inset:0;background:url("data:image/webp;base64,") center center/cover no-repeat;filter:saturate(.76) brightness(.72)}.library-shade{position:fixed;inset:0;pointer-events:none;background:linear-gradient(180deg,#131b1bda 0%,#12191b3d 24%,#15211c62 60%,#0a100fe8 100%),linear-gradient(90deg,#0d1414a6,transparent 17%,transparent 83%,#0d1414ab)}
.archive-shell{position:relative;z-index:1;min-height:100%;width:min(1280px,100%);margin:auto;padding:0 clamp(18px,4vw,64px) 22px;display:flex;flex-direction:column}
.archive-topbar{min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid #e9eee72b;position:relative}
.archive-logo{display:flex;align-items:center;gap:11px}.logo-mark{width:29px;height:29px;display:grid;place-items:center;border:1px solid #d2a68e7d;color:#d9b6a4;font-family:var(--serif);font-size:16px}.archive-logo strong{font-family:var(--serif);font-weight:600;font-size:16px;letter-spacing:.05em;display:block}.archive-logo small{display:block;font:10px var(--ui);color:#d2d9d2ac;letter-spacing:.13em;margin-top:5px}
.archive-top-actions{display:flex;gap:8px;align-items:center}.archive-locale{font-size:10px;letter-spacing:.13em;color:#d3d5c7;margin-right:12px}.tool-button{border:1px solid #e1e3d847;background:#1a2422bb;color:#e6ebe3;min-height:35px;padding:7px 11px;font-size:12px;transition:background .15s,border-color .15s}.tool-button:hover{background:#36433e;border-color:#c1cfc3}
.archive-intro{text-align:center;margin:clamp(30px,4vh,54px) auto 25px;text-shadow:0 2px 12px #10191e}.archive-kicker{font-size:11px;letter-spacing:.2em;color:#d5c3ae}.archive-kicker span{color:#c17b68}.archive-intro h1{font-family:var(--serif);font-size:clamp(33px,4.5vw,53px);font-weight:600;letter-spacing:-.055em;color:#f8f6f0;margin:12px 0 9px}.heading-red{color:#b77a63}.archive-intro p{margin:0;color:#d2d9d3;font-size:14px;letter-spacing:.02em}
.archive-collection{width:100%;max-width:1120px;margin:0 auto;position:relative;background:linear-gradient(180deg,#192521eF,#1c2925ef);border:1px solid #a5b0a351;box-shadow:0 14px 70px #080d0bc0,0 1px 0 #ffffff0c inset;padding:22px clamp(14px,3vw,36px) 12px;isolation:isolate}
.collection-head,.collection-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;color:#c2cec4}.collection-head{font-size:11px;letter-spacing:.13em;padding:0 4px 19px;border-bottom:1px solid #a9b3aa42}.collection-head span:first-child{display:flex;align-items:center;gap:8px}.collection-head i{height:1px;width:24px;background:#a66b59;display:inline-block}.collection-note{font-size:12px;letter-spacing:.01em;color:#d2d9d2a8}.collection-foot{border-top:1px solid #bdc8ba3c;padding:17px 5px 0;font-size:11px;color:#bcc7c0a6;letter-spacing:.03em}
.record-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:15px 23px;padding:15px 5px 24px;position:relative}
.record-grid:before,.record-grid:after{content:"";height:5px;position:absolute;left:4px;right:4px;background:linear-gradient(180deg,#73807388,#3e4c43cc 35%,#1e2925d1);box-shadow:0 9px 16px #060a0a99;pointer-events:none}.record-grid:before{top:50%;transform:translateY(-20px)}.record-grid:after{bottom:16px}
.roll-slot{position:relative;display:flex;align-items:center;flex-direction:column;gap:10px;border:1px solid transparent;background:transparent;color:#f4f5ed;padding:8px 6px 15px;min-width:0;min-height:204px;isolation:isolate;transition:transform .2s ease,background .2s ease,border-color .2s ease;cursor:pointer;z-index:1}
.roll-slot:hover,.roll-slot:focus-visible{transform:translateY(-4px);background:#f4f8f00a;border-color:#acc5b95c}.roll-slot:active{transform:translateY(-1px)}.roll-slot.is-selected{opacity:.2;pointer-events:none}
.roll-index{font-size:11px;letter-spacing:.12em;color:#c0b4a5;font-weight:500;line-height:1.3}.roll-visual{position:relative;display:block;width:45px;height:132px;margin:0 auto;filter:drop-shadow(3px 7px 4px #030a08a3)}
.roll-shaft{position:absolute;left:8px;right:8px;top:-4px;bottom:-4px;border-radius:10px;background:linear-gradient(90deg,#2b332e,#53635a 27%,#31433b 61%,#18241e);box-shadow:inset -4px 0 3px #08100a84,0 0 0 1px #84988863}
.roll-silk{position:absolute;left:12px;right:11px;top:5px;bottom:5px;border-left:1px solid #fffdf9aa;border-right:1px solid #cacbbd;background:linear-gradient(90deg,#d7d8cd 0%,#faf9f0 24%,#ececdf 64%,#b5bdaf 100%);box-shadow:inset -3px 0 5px #6d786e2c}
.roll-edge{position:absolute;width:37px;height:6px;left:4px;background:linear-gradient(90deg,#28372e,#788678 24%,#566052 65%,#1d2a22);border-radius:2px;z-index:2}.roll-edge.top{top:-6px}.roll-edge.bottom{bottom:-6px}
.roll-caption{display:flex;flex-direction:column;align-items:center;gap:3px;line-height:1.3;min-width:0}.roll-caption strong{font-family:var(--serif);font-size:18px;font-weight:600;color:#f8f5ed;letter-spacing:-.02em}.roll-caption small{font-size:13px;color:#c0c9c0;white-space:normal;word-break:keep-all}.roll-slot[aria-current="true"] .roll-index:before{content:"•";margin-right:5px;color:#e8a48c}
.archive-footer{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 5px 8px;font-size:11px;letter-spacing:.06em;color:#e8eae2ab;text-shadow:0 1px 6px #090c0b}.archive-footer a{color:#f2eee5;text-decoration:none;border-bottom:1px solid #f2eee569;padding-bottom:3px}.archive-footer a:hover{border-bottom-color:#fff}
/* A physical rolled manuscript: one vertical axle, then reveal fixed-size horizontal writing surface. */
.record-layer{position:fixed;inset:0;z-index:20;visibility:hidden;pointer-events:none;overscroll-behavior:contain}.record-layer.active{visibility:visible;pointer-events:auto}.record-veil{position:absolute;inset:0;background:#080e0cde;opacity:0;backdrop-filter:blur(5px);transition:opacity .3s ease}.record-layer.active .record-veil{opacity:1}
.floating-record{position:absolute;left:0;top:0;width:45px;height:154px;z-index:2;isolation:isolate;--record-accent:#9d624f;color:var(--ink)}
.floating-closed{position:absolute;left:0;top:0;width:100%;height:100%;z-index:10;filter:drop-shadow(2px 9px 7px #0009);transition:opacity .14s}.floating-closed .closed-shaft{position:absolute;top:-5px;bottom:-5px;left:10%;right:10%;background:linear-gradient(90deg,#242e27,#66756a 28%,#2e3e34 65%,#1a261e);border-radius:8px}.floating-closed .closed-silk{position:absolute;top:4%;bottom:4%;left:27%;right:27%;background:linear-gradient(90deg,#c8cfc5,#fbf8f0 30%,#c4cec3);border-radius:2px}.floating-closed .closed-seam{position:absolute;left:12%;right:12%;top:-6px;height:7px;background:#57695a;border-radius:3px;box-shadow:0 calc(var(--height, 150px) + 2px) #57695a}
.floating-record.unrolling .floating-closed{opacity:0;pointer-events:none}
.paper-window{position:absolute;top:0;bottom:0;left:17px;width:0;overflow:hidden;opacity:0;background:var(--silk);border-top:8px solid #c8cdc4;border-bottom:8px solid #b7c2b4;box-shadow:0 17px 40px #0007,inset 0 0 0 1px #d8d9ca;will-change:width;z-index:2}
.floating-record.unrolling .paper-window{opacity:1}.sheet-content{width:var(--inner-width,1000px);height:100%;background:#f7f5ef;display:grid;grid-template-columns:48% 52%;overflow:hidden;min-width:0}
.roll-axis{position:absolute;top:-8px;bottom:-8px;left:0;width:25px;opacity:0;z-index:8;border-radius:6px;background:linear-gradient(90deg,#1d2d25,#617163 24%,#38473b 55%,#19271f 88%);border:1px solid #7c89794b;box-shadow:2px 0 8px #090e0b77}.roll-axis:before,.roll-axis:after{content:"";position:absolute;height:7px;left:-5px;right:-5px;border-radius:2px;background:linear-gradient(90deg,#202d24,#718274 28%,#394638 76%,#1e2b24)}.roll-axis:before{top:-4px}.roll-axis:after{bottom:-4px}.floating-record.unrolling .roll-axis{opacity:1}
.portrait-side{background:#dce1da;min-height:0;min-width:0;border-right:1px solid #d7dcd4;display:flex;flex-direction:column;padding:clamp(14px,2vw,26px);gap:12px}.portrait-container{position:relative;flex:1;min-height:0;display:flex;align-items:center;justify-content:center;background:#dee1d9;overflow:hidden}.portrait-container img{display:block;width:100%;height:100%;max-height:100%;object-fit:contain;object-position:center center}.art-view{position:absolute;right:10px;bottom:10px;padding:9px 13px;background:#1e2d28d9;color:#fff;font-family:var(--ui);font-size:12px;border:1px solid #dbe4d9ad;backdrop-filter:blur(6px)}.portrait-credit{display:flex;justify-content:space-between;gap:8px;font-family:var(--serif);font-size:11px;color:#65766c;letter-spacing:.06em}
.person-detail{overflow:auto;min-height:0;padding:clamp(22px,3.25vw,45px) clamp(20px,3vw,45px) 92px;scrollbar-color:#aab5ac #f7f5ef;scrollbar-width:thin}.detail-topline{display:flex;justify-content:space-between;gap:12px;font-size:10px;letter-spacing:.13em;color:#73827a;margin-bottom:27px}.rank-line{font-size:12px;font-weight:600;letter-spacing:.17em;color:#a36553}.person-title{display:flex;align-items:baseline;flex-wrap:wrap;column-gap:17px;row-gap:5px;padding-bottom:20px;border-bottom:1px solid #d4dad3}.person-title h2{font:600 clamp(28px,3vw,40px)/1.3 var(--serif);color:#202725;letter-spacing:-.05em;margin:0}.person-aka{font:500 15px/1.5 var(--serif);color:#687c73}
.person-facts{margin:22px 0 25px;display:grid;grid-template-columns:1fr 1fr;gap:1px;border:1px solid #dfe2dc;background:#dfe2dc}.person-facts div{display:flex;flex-direction:column;gap:7px;background:#faf9f5;padding:13px 16px;min-width:0}.person-facts .fact-full{grid-column:span 2}.person-facts span{font:12px var(--ui);color:#738178}.person-facts strong{font:500 15px/1.45 var(--ui);color:#2a3430;word-break:keep-all}
.detail-section{padding:0 0 20px;margin:0 0 22px;border-bottom:1px solid #d9dcd6}.detail-section h3{margin:0 0 9px;font:600 13px var(--ui);color:#4f685d}.detail-section p{font:400 16px/1.75 var(--ui);color:#3c4841;word-break:keep-all;margin:0}.speciality>strong{font:600 20px/1.45 var(--serif);display:block;margin:5px 0 7px;color:#26312b}.speciality p{font-size:14px;line-height:1.7}
.arts-detail{padding:0 0 15px;border-bottom:1px solid #d9dcd6}.arts-detail summary{font:500 14px var(--ui);cursor:pointer;color:#35493e;list-style:none}.arts-detail summary::-webkit-details-marker{display:none}.arts-detail summary span{float:right;font-size:19px}.arts-detail[open] summary span{transform:rotate(45deg)}#personArts{font:14px/1.9 var(--ui);color:#3c4e44;padding-top:14px}
.record-close{position:absolute;z-index:12;top:23px;right:35px;color:#1a2a22;background:#f9f8f5e7;border:1px solid #8a9a8d88;width:38px;height:38px;font:29px/1 var(--ui);cursor:pointer}.record-close:hover{background:#e9eae4}
.record-controls{position:absolute;z-index:10;bottom:13px;left:calc(48% + 35px);right:45px;height:53px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid #d7dcd4;background:#f7f5ef;padding:9px 0 0}.record-controls button{border:0;background:none;color:#26362e;padding:8px 5px;font:600 13px var(--ui)}.record-controls button:hover{color:#a85e4b}.record-controls span{font-size:12px;letter-spacing:.11em;color:#7b8c7f}
.zoom-layer{position:fixed;inset:0;z-index:35;display:flex;align-items:center;justify-content:center;background:#070d0ceb;padding:50px 15px 20px}.zoom-layer[hidden]{display:none}.zoom-layer img{display:block;max-width:100%;max-height:100%;object-fit:contain;box-shadow:0 10px 50px #0008}.zoom-layer button{position:absolute;top:12px;right:15px;background:#f7f5ed;color:#25342b;border:0;padding:10px 18px}
@media(min-width:1300px) and (min-height:850px){.archive-intro{margin-top:52px;margin-bottom:33px}.roll-visual{height:156px}.roll-slot{min-height:228px}}
@media(max-width:820px){.archive-topbar{min-height:66px}.archive-locale{display:none}.archive-shell{padding-inline:18px}.archive-intro{margin:35px auto 20px}.archive-intro h1{font-size:38px}.record-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px}.roll-slot{min-height:188px}.roll-visual{height:125px}.collection-foot{font-size:10px}.sheet-content{grid-template-columns:1fr;grid-template-rows:auto auto;overflow:visible}.paper-window{overflow:hidden;background:#f7f5ef}.portrait-side{height:auto;border-right:0;border-bottom:1px solid #d7dcd4;padding:18px;gap:7px}.portrait-container{height:auto;min-height:0;aspect-ratio:1/1;flex:none}.portrait-container img{height:100%;object-fit:contain}.person-detail{overflow:visible;padding:25px 22px 108px}.record-controls{left:35px;right:35px;bottom:16px}.record-close{top:14px;right:29px}.record-layer.active{overflow-y:auto}.floating-record{min-height:0}}
@media(max-width:480px){.archive-top-actions{gap:4px}.tool-button{font-size:11px;min-height:34px;padding:6px 8px}.tool-button span{display:none}.archive-logo strong{font-size:14px}.archive-logo small{font-size:9px}.archive-intro{margin-top:25px}.archive-intro h1{font-size:32px}.archive-intro p{font-size:12px}.archive-kicker{font-size:9px;letter-spacing:.12em}.archive-collection{padding:17px 12px 12px}.collection-head{font-size:9px;padding-bottom:13px}.collection-note{font-size:10px}.record-grid{padding:16px 2px 20px;gap:6px}.roll-slot{min-height:182px;gap:8px}.roll-caption strong{font-size:17px}.roll-caption small{font-size:12px}.collection-foot span:nth-child(2){display:none}.archive-footer{font-size:10px}.detail-topline{margin-bottom:16px}.person-detail{padding:20px 19px 110px}.person-facts div{padding:11px 12px}.person-facts strong{font-size:14px}.detail-section p{font-size:16px}.record-close{right:24px}.record-controls{left:28px;right:28px}.record-controls button{font-size:12px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

.sheet-content{opacity:0;transition:opacity .23s ease}.floating-record.content-visible .sheet-content{opacity:1}

/* The native architectural lintel hides the unmatched narrow sky strip above moving door sprites. */
.gate-art::before{content:"";position:absolute;left:32.52%;width:34.72%;top:32.7%;height:3.9%;z-index:3;background:linear-gradient(180deg,#2a211e 0%,#40302a 44%,#201a18 100%);box-shadow:inset 0 3px 5px #0b080866,0 5px 8px #0b080855}
/* Navigational controls only appear once the physical roll finishes opening. */
.record-controls{opacity:0;pointer-events:none;transition:opacity .18s ease}
.floating-record.content-visible .record-controls{opacity:1;pointer-events:auto}

/* ── Intro refinement v3: restrained illustrated wuxia opening ── */
.gate-art::before{display:block!important;left:32.47%;top:32.88%;width:34.67%;height:2.48%;background:linear-gradient(180deg,#241c1a 0%,#48312a 50%,#281d1b 100%);box-shadow:inset 0 1px 1px #95715b44,0 2px 4px #1c131280}
.floor-plane,.jamb{display:none!important}
.inner-view{clip-path:none!important}
.arrival{background:#17201f;transition:opacity .40s ease,visibility .40s ease}
.courtyard-art{filter:brightness(.90) saturate(.83) contrast(1.04)}
.glimmer{
 width:4px;height:4px;border-radius:50%;
 background:#fff6dd;
 box-shadow:0 0 4px 1px rgba(255,238,188,.50),0 0 9px 2px rgba(255,232,183,.20);
 animation:handle-sheen 5.7s ease-in-out infinite;
}
.glimmer:before,.glimmer:after{display:none!important}
.glimmer-right{animation-delay:.46s}
@keyframes handle-sheen{
 0%,13%,23%,100%{opacity:0;transform:scale(.7)}
 16%,19%{opacity:.53;transform:scale(1)}
}
.skip-entry{
 background:rgba(22,29,29,.76);border:1px solid rgba(242,236,223,.34);
 color:#f0ebe0;box-shadow:none;border-radius:2px;
 font-size:12px;letter-spacing:.02em;padding:10px 14px;
 backdrop-filter:blur(3px)
}
.skip-entry:hover{background:rgba(22,29,29,.94);border-color:rgba(242,236,223,.60)}
@media (max-width:600px){
 .skip-entry{right:12px;bottom:max(14px,env(safe-area-inset-bottom));font-size:11px;padding:10px 12px}
}

/* ───《江湖十尊》 ink-and-paper split-door entry ─── */
.sumi-arrival{position:absolute;inset:0;z-index:5;opacity:1;visibility:visible;background:#efddbc;overflow:hidden;transition:none}
.sumi-arrival.leaving{opacity:1;visibility:visible;pointer-events:none}
.sumi-arrival.opening{background:transparent!important}
.sumi-arrival[hidden]{display:none!important}
.door-pair{position:absolute;inset:0;pointer-events:none;overflow:hidden;isolation:isolate}
.slide-panel{position:absolute;top:0;bottom:0;width:50%;overflow:hidden;will-change:transform;transition:transform 1.45s cubic-bezier(.67,.02,.16,1) .14s;backface-visibility:hidden}
.slide-left{left:0;transform:translate3d(0,0,0);z-index:2}
.slide-right{right:0;transform:translate3d(0,0,0);z-index:1}
.slide-paper{position:absolute;top:0;height:100%;width:200%;background-color:#efddbc;background-image:url('data:image/webp;base64,');background-repeat:no-repeat;background-size:cover;background-position:center center;box-shadow:inset 0 0 85px #906c3920}
.slide-paper-left{left:0}.slide-paper-right{right:0}
.slide-panel::before,.slide-panel::after{content:"";position:absolute;left:0;right:0;height:8px;pointer-events:none;z-index:3;background:linear-gradient(180deg,#332a21d9,#7c6148b3 35%,#2c251fd5);box-shadow:0 3px 10px #33281d24}
.slide-panel::before{top:0}.slide-panel::after{bottom:0;transform:rotate(180deg)}
.door-frame{position:absolute;top:0;bottom:0;width:clamp(12px,2.3vw,30px);z-index:4;pointer-events:none;background:linear-gradient(90deg,#3e3328,#806a50 18%,#69533c 42%,#342a21 87%,#2b2119);box-shadow:0 0 10px #4b33273a,inset 0 0 0 1px #392a1c80}
.door-frame::after{content:"";position:absolute;top:1%;bottom:1%;left:50%;width:1px;background:#d7bd955c}
.slide-left .door-frame-outside{left:0}.slide-right .door-frame-outside{right:0}
.slide-left .door-frame-center{right:0;width:clamp(10px,1.4vw,20px)}.slide-right .door-frame-center{left:0;width:clamp(10px,1.4vw,20px)}
.door-pull{position:absolute;z-index:5;top:55%;width:10px;height:34px;border-radius:6px;border:1px solid #5b4938;background:linear-gradient(90deg,#6f5c42,#bda680 55%,#5a4635);box-shadow:0 2px 5px #1e181744}
.slide-left .door-pull{right:clamp(20px,3vw,44px)}.slide-right .door-pull{left:clamp(20px,3vw,44px)}
.sumi-arrival.opening .slide-left{transform:translate3d(-102%,0,0)}
.sumi-arrival.opening .slide-right{transform:translate3d(102%,0,0)}
.intro-content{position:absolute;z-index:7;top:clamp(72px,13vh,154px);left:clamp(48px,12vw,230px);width:min(430px,calc(100% - 84px));color:#292822;text-align:left;pointer-events:none;transition:opacity .20s ease,transform .27s ease}
.intro-content button{pointer-events:auto}
.intro-overline{font:600 11px/1.4 var(--ui);letter-spacing:.26em;color:#615748;display:flex;align-items:center;gap:12px}
.intro-overline span{width:26px;height:1px;background:#9a5246;display:inline-block}
.intro-content h1{font-family:var(--serif);font-size:clamp(49px,6.8vw,91px);font-weight:600;letter-spacing:-.065em;margin:20px 0 5px;line-height:1.16;color:#25241f;text-shadow:0 1px 1px #fff4dd77}
.intro-hanzi{font:500 19px/1.6 var(--serif);letter-spacing:.30em;color:#474034;display:flex;align-items:center;gap:14px}
.intro-seal{display:inline-grid;place-items:center;font:500 14px var(--serif);letter-spacing:0;width:24px;height:24px;background:#a34836;color:#f9edce}
.intro-subtitle{margin-top:24px;color:#6a6151;font:400 13px/1.7 var(--ui);letter-spacing:.05em}
.ink-enter{margin-top:32px;min-width:185px;height:48px;border:1px solid #2e3029;background:#282d29;color:#f7eee1;padding:0 20px;display:inline-flex;align-items:center;justify-content:space-between;gap:42px;font-size:14px;letter-spacing:.13em;box-shadow:0 6px 14px #2e251d1e;transition:background .19s,color .19s,transform .19s,border-color .19s}
.ink-enter span{font-size:20px;font-family:var(--ui);font-weight:300;letter-spacing:0}
.ink-enter:hover{background:#f5e5c7;color:#282d29;border-color:#4e5147;transform:translateY(-2px)}
.ink-enter:active{transform:translateY(0)}.ink-enter:disabled{opacity:.7}
.intro-audio{position:absolute;top:26px;right:clamp(30px,4vw,66px);z-index:8;border:0;border-bottom:1px solid #655b4b55;background:transparent;color:#4f493f;font:500 11px var(--ui);letter-spacing:.05em;padding:8px 2px;transition:opacity .2s}
.intro-audio:hover{opacity:.55}
.intro-caption{position:absolute;right:clamp(35px,5vw,78px);bottom:24px;z-index:7;font:500 10px var(--serif);letter-spacing:.2em;color:#695e50aa;transition:opacity .15s}
.sumi-arrival.opening .intro-content{opacity:0;transform:translateY(-8px);pointer-events:none}
.sumi-arrival.opening .intro-audio,.sumi-arrival.opening .intro-caption{opacity:0;pointer-events:none}
.sumi-arrival .skip-entry{background:#242b28dd;color:#f5eddf;border-color:#e0d1ba66;z-index:11;right:24px;bottom:24px}
.library.entry-ready{transition:none!important;opacity:1;visibility:visible}
@media(max-width:760px){
 .slide-paper{background-position:68% center}
 .intro-content{top:clamp(75px,12vh,115px);left:clamp(27px,7vw,48px);width:calc(100% - 52px)}
 .intro-content h1{font-size:clamp(45px,12vw,64px);margin-top:17px}
 .intro-hanzi{font-size:15px;letter-spacing:.19em}
 .intro-subtitle{font-size:12px;max-width:280px;margin-top:19px}
 .ink-enter{margin-top:28px;height:48px;min-width:176px}
 .intro-audio{top:18px;right:22px}
 .intro-caption{bottom:16px;right:18px;font-size:8px}
 .door-frame{width:12px}.slide-left .door-frame-center,.slide-right .door-frame-center{width:10px}
 .slide-left .door-pull{right:18px}.slide-right .door-pull{left:18px}
}
@media(max-width:520px){
 .intro-content{left:23px;top:clamp(94px,12.5vh,125px);width:calc(100% - 46px)}
 .intro-content h1{font-size:39px;letter-spacing:-.085em;white-space:nowrap}
 .intro-overline{font-size:9px;letter-spacing:.17em;gap:8px}
 .intro-overline span{width:18px}
 .intro-hanzi{font-size:12px;letter-spacing:.14em;gap:9px}
 .intro-seal{width:19px;height:19px;font-size:11px}
 .intro-subtitle{font-size:10px;max-width:163px;margin-top:17px;line-height:1.75;word-break:keep-all}
 .ink-enter{margin-top:23px;min-width:150px;width:150px;height:44px;gap:12px;padding:0 13px;font-size:12px}
}
@media(max-width:480px) and (max-height:690px){.intro-content{top:56px}.intro-content h1{font-size:43px}.intro-subtitle{margin-top:10px}.ink-enter{margin-top:17px}}
@media(prefers-reduced-motion:reduce){.slide-panel{transition:none!important}.intro-content{transition:none!important}.ink-enter{transition:none!important}}


/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   江湖十尊 · 2026 renewed edition
   Quiet hanji, lattice screens, traditional split-doors and paper archive
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
:root{
  --wood:#33251b;--wood-deep:#1f1713;--wood-edge:#71503a;
  --h-paper:#f1dfbf;--h-silk:#f4e7d1;--h-ink:#2e271f;--h-red:#a94735;--ink-paint:url("data:image/webp;base64,");
  --serif:'Noto Serif CJK KR','Nanum Myeongjo','Noto Serif KR',serif;
  --ui:'Noto Sans CJK KR','Nanum Gothic','Malgun Gothic',sans-serif;
}
html,body{background:#251b16}
#experience{background:#251b16}
/* Intro: one central vertical scroll, surrounded by quiet lattice wings. */
.new-intro{
 position:absolute;inset:0;z-index:5;overflow:hidden;opacity:1;visibility:visible;
 background:radial-gradient(ellipse at 50% 45%,#f6e6c8 0%,#e7d2ac 73%,#bfa27d 100%);
 color:#33281f;transition:none;
}
.new-intro[hidden]{display:none!important}
.new-intro::before{
 content:"";position:absolute;inset:0;pointer-events:none;opacity:.52;
 background:repeating-linear-gradient(103deg,transparent 0px,transparent 47px,#74533108 49px,transparent 51px),
 radial-gradient(ellipse at 11% 94%,#8a715526,transparent 48%),radial-gradient(ellipse at 92% 11%,#ac917022,transparent 53%);
}
.new-intro::after{content:"";pointer-events:none;position:absolute;inset:0;z-index:0;box-shadow:inset 0 0 85px #39291e31}
.intro-stage{
 position:absolute;z-index:2;inset:0;margin:auto;
 width:min(1160px,100%);height:100%;max-height:1020px;
 display:grid;grid-template-columns:minmax(30px,1fr) minmax(0,710px) minmax(30px,1fr);
 align-items:stretch;isolation:isolate;
}
.intro-side{
 position:relative;z-index:2;overflow:hidden;
 background:linear-gradient(90deg,#1d1611 0,#483324 8%,#38271e 13%,#281e18 18%,#3f2c20 80%,#221914 88%,#543c2a 95%,#251c17 100%);
 box-shadow:inset 0 0 34px #0008,0 0 28px #25191156;
 transition:opacity .18s ease;
}
.intro-side::before{
 content:"";position:absolute;inset:12px 16% 12px;
 border:7px solid #4d3324;outline:2px solid #140f0c;
 background-color:#d9c4a4;
 background-image:linear-gradient(90deg,transparent calc(33.333% - 2px),#322218 calc(33.333% - 2px),#322218 calc(33.333% + 2px),transparent calc(33.333% + 2px),transparent calc(66.666% - 2px),#322218 calc(66.666% - 2px),#322218 calc(66.666% + 2px),transparent calc(66.666% + 2px)),
 repeating-linear-gradient(0deg,transparent 0,transparent 86px,#322218 87px,#322218 91px,transparent 92px),
 linear-gradient(135deg,#fff3d2bb,#c7ab83aa);
 box-shadow:inset 0 0 23px #6e462b65,0 0 0 7px #241913;
}
.intro-side::after{content:"";position:absolute;inset:0 0 0 auto;width:11px;background:linear-gradient(90deg,#1c120d,#74503a,#291a11);box-shadow:0 0 12px #140d09ab}
.intro-side-right::after{left:0;right:auto}
.intro-portal{
 position:relative;z-index:3;min-width:0;overflow:hidden;
 border-left:9px solid #4a3224;border-right:9px solid #4a3224;
 border-top:8px solid #362419;border-bottom:8px solid #362419;
 background:var(--h-paper);
 box-shadow:0 0 0 1px #16100c,0 11px 45px #24140e70, inset 0 0 35px #38271e42;
 transition:border-color .14s ease,box-shadow .16s ease;
}
.intro-portal::before,.intro-portal::after{
 content:"";position:absolute;z-index:6;pointer-events:none;left:0;right:0;height:8px;
 background:linear-gradient(180deg,#2b1a12,#80573a 42%,#2d1d13);box-shadow:0 3px 12px #3723144f;
}
.intro-portal::before{top:0}.intro-portal::after{bottom:0;transform:rotate(180deg)}
.poster-doors{position:absolute;z-index:1;inset:0;pointer-events:none}
.intro-leaf{
 position:absolute;top:0;bottom:0;width:50%;overflow:hidden;
 background:#ebd6b7;will-change:transform;backface-visibility:hidden;
 transition:transform .88s cubic-bezier(.68,.02,.24,1);
}
.intro-leaf-left{left:0}.intro-leaf-right{right:0}
.leaf-paper{
 position:absolute;top:0;bottom:0;width:200%;
 background-color:#f0ddbc;
 background-image:
  radial-gradient(ellipse at 18% 32%,#fff1d4a0,transparent 49%),
  radial-gradient(ellipse at 81% 76%,#be977d32,transparent 60%),
  repeating-linear-gradient(112deg,transparent 0,transparent 6px,#9f88660a 7px,transparent 8px);
 box-shadow:inset 0 0 65px #8b69423b;
}
.intro-leaf-left .leaf-paper{left:0}.intro-leaf-right .leaf-paper{right:0}
.leaf-paint{
 position:absolute;top:35%;width:200%;height:42%;
 background-image:var(--ink-paint);
 background-position:center;background-repeat:no-repeat;background-size:cover;
 opacity:.93;
 -webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 18%,#000 77%,transparent 100%);
 mask-image:linear-gradient(180deg,transparent 0%,#000 18%,#000 77%,transparent 100%);
}
.intro-leaf-left .leaf-paint{left:0}.intro-leaf-right .leaf-paint{right:0}
.intro-leaf-left::after,.intro-leaf-right::after{
 content:"";position:absolute;top:0;bottom:0;width:7px;
 background:linear-gradient(90deg,#37251a,#a07851,#39251a);
 box-shadow:0 0 9px #4e2a1c5c;z-index:2
}
.intro-leaf-left::after{right:0}.intro-leaf-right::after{left:0}
.poster-copy{position:absolute;z-index:4;inset:0;pointer-events:none;transition:opacity .18s ease,transform .18s ease}
.poster-copy button{pointer-events:auto}
.poster-heading{position:absolute;top:9.5%;left:11%;right:10%;text-align:left}
.poster-overline{display:flex;align-items:center;gap:12px;font:500 11px/1.5 var(--serif);letter-spacing:.17em;color:#645441}
.poster-overline::before{content:"";display:block;width:22px;height:1px;background:#a04c36}
.poster-heading h1{font:700 clamp(47px,6.5vw,78px)/1.23 var(--serif);letter-spacing:-.105em;color:#201d1a;margin:13px 0 8px;text-shadow:1px 1px 0 #f7eddd44;white-space:nowrap}
.poster-hanzi{display:flex;align-items:center;gap:13px;font:500 15px var(--serif);letter-spacing:.23em;color:#514335}
.poster-seal{width:25px;height:28px;display:inline-grid;place-items:center;background:#aa4939;color:#f9e7c9;font:600 12px var(--serif);letter-spacing:0;transform:rotate(-4deg)}
.poster-subtitle{margin:15px 0 0 2px;font:400 12px/1.65 var(--serif);letter-spacing:.055em;color:#655541;word-break:keep-all}
.poster-bottom{position:absolute;bottom:9%;left:0;right:0;text-align:center}
.poster-button{
 min-width:210px;min-height:51px;padding:0 25px;
 color:#f6e7ce;background:#28231f;border:1px solid #8d7358;
 outline:1px solid #2e251d;outline-offset:3px;
 box-shadow:0 7px 0 -3px #22170f23,0 8px 22px #22151050;
 font:500 17px var(--serif);letter-spacing:.17em;
 transition:background .17s ease,box-shadow .17s ease,transform .17s ease;
}
.poster-button span{padding:0 15px;font-size:12px;color:#bb9b73}
.poster-button:hover{background:#42362a;box-shadow:0 10px 26px #24170e63;transform:translateY(-2px)}
.poster-button:active{transform:translateY(0)}.poster-button:disabled{opacity:.7}
.poster-smallprint{margin-top:19px;color:#77624bb5;font:500 10px var(--serif);letter-spacing:.2em}
.intro-audio{position:absolute;z-index:8;top:17px;right:max(20px,calc((100vw - 1210px)/2));border:1px solid #93785d5c;background:#f3e3c6e8;color:#504235;padding:8px 13px;font:500 12px var(--serif);letter-spacing:.025em;box-shadow:0 2px 12px #46321e18}
.intro-audio:hover{background:#fff1d6}
.new-intro .skip-entry{display:none!important}
.new-intro.opening{background:transparent!important;pointer-events:none}
.new-intro.opening::before,.new-intro.opening::after{opacity:0}
.new-intro.opening .intro-leaf-left{transform:translateX(-103%)}
.new-intro.opening .intro-leaf-right{transform:translateX(103%)}
.new-intro.opening .poster-copy{opacity:0;transform:translateY(-7px)}
.new-intro.opening .intro-side,.new-intro.opening .intro-audio{opacity:0;pointer-events:none}
.new-intro.opening .intro-portal{border-color:transparent;box-shadow:none;overflow:hidden;background:transparent}
.new-intro.opening .intro-portal::before,.new-intro.opening .intro-portal::after{opacity:0}
.library.entry-ready{transition:none!important;opacity:1;visibility:visible}

/* Archive: warm dark wood and parchment, never a glossy mobile-game panel. */
.library{background:#1e1612;color:#f1e3ca}
.library-art{filter:sepia(.90) saturate(.50) brightness(.43) contrast(.86)}
.library-shade{background:linear-gradient(180deg,#1b110cf5,#24150db0 28%,#23150db9 73%,#130b09f4),linear-gradient(90deg,#160c08d6,transparent 29%,transparent 73%,#160c08d6)}
.archive-shell{max-width:1220px;padding:0 clamp(15px,3vw,48px) 18px}
.archive-topbar{min-height:62px;border-bottom:1px solid #d6bb8952}
.archive-logo .logo-mark{border-color:#b28e67a8;color:#f3d9a6;background:#26170f}
.archive-logo strong{color:#f3dfbf}.archive-logo small{color:#dac5a1a3}
.archive-locale{color:#c6ac87}
.tool-button{background:#251911ad;border-color:#caa87c68;color:#ead3b1;border-radius:1px}
.tool-button:hover{background:#483222;border-color:#e8c99d}
.archive-plaque{
 align-self:center;margin:13px auto 0;min-width:202px;
 padding:6px 25px 8px;text-align:center;
 font:700 25px/1.45 var(--serif);letter-spacing:.35em;text-indent:.35em;
 color:#e8c79a;text-shadow:0 2px 1px #110907;
 border:6px ridge #573820;outline:1px solid #ad8255;
 box-shadow:inset 0 0 0 1px #ad7d51,0 8px 20px #0b0505a5;
 background:linear-gradient(135deg,#362416,#1c1410 44%,#352219);
}
.archive-plaque small{display:block;letter-spacing:.23em;text-indent:0;font:500 8px var(--serif);color:#9a7451}
.archive-intro{text-align:center;margin:11px auto 20px;text-shadow:0 2px 8px #0b0707}
.archive-kicker{font:500 10px var(--serif);letter-spacing:.15em;color:#bca580}
.archive-intro h1{font:600 clamp(28px,3.3vw,38px)/1.3 var(--serif);color:#f6e5c8;margin:7px 0 5px;letter-spacing:-.045em}
.archive-intro p{font:400 12px/1.7 var(--serif);color:#d7c5a8}
.heading-red{color:#ab563f}
.archive-collection{
 max-width:1080px;padding:15px clamp(12px,2vw,28px) 6px;
 background:linear-gradient(90deg,#1d130eec,#3d281ce3 2%,#302016f3 48%,#38261ae9 97%,#1b120eed);
 border:1px solid #8a604079;outline:2px solid #180f0d;outline-offset:3px;
 box-shadow:0 15px 50px #000b,inset 0 0 0 3px #7c543125,inset 0 0 35px #090502b9;
}
.collection-head{border-bottom:1px solid #b58d6173;padding-bottom:13px;color:#d5bfa0}
.collection-note{color:#ddc7a9}
.collection-head i{background:#a55b41}
.record-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:10px 12px;padding:11px 5px 14px}
.record-grid::before,.record-grid::after{height:7px;left:8px;right:8px;background:linear-gradient(#170d08,#835c3d 52%,#28170e);box-shadow:0 4px 12px #090402a8}
.record-grid::before{top:51%;transform:translateY(-8px)}.record-grid::after{bottom:8px}
.roll-slot{min-height:182px;padding:4px 5px 11px;gap:6px;color:#f1ddbc}
.roll-slot:hover,.roll-slot:focus-visible{transform:translateY(-3px);background:#e5c49212;border-color:#d6ab765c}
.roll-index{color:#c6a178;font:500 11px/1.5 var(--serif);letter-spacing:.1em}
.roll-visual{width:45px;height:111px;filter:drop-shadow(3px 6px 4px #000a)}
.roll-shaft{background:linear-gradient(90deg,#322015,#906840 20%,#65462d 47%,#2b1b13);box-shadow:inset -4px 0 4px #140b088a,0 0 0 1px #b48a5f7b}
.roll-silk{background:linear-gradient(90deg,#baa88e,#fae9c8 22%,#e8d5b5 62%,#af997e 100%);border-left:1px solid #ffebc3a8;border-right:1px solid #927657}
.roll-edge{background:linear-gradient(90deg,#2b1a0f,#a27343 20%,#604124 65%,#27170e)}
.roll-caption{gap:2px}
.roll-caption strong{font:600 16px/1.35 var(--serif);color:#f4dfbf}
.roll-caption small{font:400 12px/1.35 var(--serif);color:#c4ac8e}
.collection-foot{border-top:1px solid #b58d615c;padding:10px 4px 0;color:#cbb08f}
.archive-footer{padding-top:21px;color:#c4ab89}
.archive-footer a{color:#f2d9ad;border-color:#d7b1887a}
.archive-footer a:hover{background:#543723}
/* Open paper is the same handmade material as the closed roll. All scroll behavior remains intact. */
.record-veil{background:#0f0906eb}
.paper-window{background:#f3e6cf;border-top-color:#bca482;border-bottom-color:#bca482}
.sheet-content{background:#f5ebd8}
.floating-closed .closed-shaft{background:linear-gradient(90deg,#34221a,#98744d 28%,#573d27 70%,#251711)}
.floating-closed .closed-silk{background:linear-gradient(90deg,#c8b599,#f6e7c9 33%,#c9b496)}
.floating-closed .closed-seam{background:#8f633e;box-shadow:0 calc(var(--height,150px) + 2px) #8f633e}
.roll-axis{background:linear-gradient(90deg,#302017,#906942 23%,#543722 60%,#241811);border-color:#9f7755}
.roll-axis::before,.roll-axis::after{background:linear-gradient(90deg,#281b13,#a57c51 28%,#593d28 76%,#25160f)}
.portrait-side{background:#dfd1b6;border-color:#bda988}
.portrait-container{background:#e7d9be}
.portrait-credit,.detail-topline{color:#846f56}
.person-facts{background:#dac7a7;border-color:#d5c5a7}
.person-facts div{background:#fffaf0}
.person-facts span{color:#7b6a51}.person-facts strong{color:#342b22}
.person-detail{scrollbar-color:#bca580 #f5ebd8}
.person-title h2{color:#33271d}.person-aka{color:#75634e}
.detail-section h3{color:#786148}.detail-section p{color:#3f352c}
.speciality>strong{color:#46301f}
.arts-detail summary,#personArts{color:#4a3828}
.record-controls{background:#f5ebd8;border-color:#d9c6a9}
.record-controls button{color:#49382a}
.record-close{color:#473221;border-color:#b8a283;background:#fff8e9}
@media(max-width:820px){
 .intro-stage{width:100%;grid-template-columns:minmax(15px,1fr) minmax(0,630px) minmax(15px,1fr)}
 .intro-side::before{left:23%;right:23%;border-width:4px}
 .archive-plaque{margin-top:10px;min-width:170px;padding:5px 12px;font-size:21px}
 .archive-intro{margin-bottom:14px}
 .record-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 8px}
 .record-grid::before,.record-grid::after{display:none}
 .roll-slot{min-height:172px}
 .archive-collection{max-width:650px}
}
@media(max-width:520px){
 .intro-stage{grid-template-columns:18px minmax(0,1fr) 18px}
 .intro-side::before{inset:8px 1px;border-width:2px;outline-width:1px;background-size:auto}
 .intro-portal{border-left-width:4px;border-right-width:4px;border-top-width:5px;border-bottom-width:5px}
 .intro-portal::before,.intro-portal::after{height:5px}
 .intro-leaf-left::after,.intro-leaf-right::after{width:4px}
 .poster-heading{top:14%;left:7%;right:5%}
 .poster-overline{font-size:9px;gap:8px;letter-spacing:.1em}
 .poster-overline::before{width:14px}
 .poster-heading h1{font-size:clamp(36px,11vw,53px);margin:12px 0 8px}
 .poster-hanzi{font-size:11px;letter-spacing:.12em;gap:8px}
 .poster-seal{width:20px;height:22px;font-size:10px}
 .poster-subtitle{font-size:10px;line-height:1.8;margin-top:10px}
 .leaf-paint{top:37%;height:38%;background-size:cover}
 .poster-bottom{bottom:12%}
 .poster-button{min-height:44px;min-width:175px;font-size:15px;padding:0 14px}
 .poster-button span{padding:0 11px}
 .poster-smallprint{font-size:9px;margin-top:18px}
 .intro-audio{top:11px;right:24px;font-size:10px;padding:6px 10px}
 .archive-shell{padding:0 13px 20px}
 .archive-topbar{min-height:62px}
 .archive-locale{display:none}
 .archive-logo strong{font-size:14px}
 .archive-logo small{font-size:9px}
 .archive-plaque{font-size:20px}
 .archive-intro h1{font-size:30px}
 .archive-intro p{font-size:11px;line-height:1.5}
 .archive-collection{padding:13px 10px 5px}
 .collection-head{font-size:10px;letter-spacing:.03em}
 .collection-note{font-size:10px}
 .record-grid{gap:8px 5px;padding:12px 2px 17px}
 .roll-slot{min-height:170px;padding:6px 3px 9px}
 .roll-visual{height:104px}
 .roll-caption strong{font-size:16px}
 .collection-foot{font-size:10px}
}
@media(max-width:380px){
 .poster-heading{top:16%}.poster-heading h1{font-size:35px}
 .leaf-paint{top:39%;height:36%}
 .archive-top-actions .tool-button{padding:6px 5px;font-size:10px}
 .archive-logo{gap:6px}
}
@media(max-height:610px) and (min-width:601px){
 .poster-heading{top:6%}.poster-heading h1{font-size:50px;margin:7px 0}
 .leaf-paint{top:32%;height:48%}.poster-bottom{bottom:6%}
 .archive-plaque{margin-top:5px;font-size:19px}
 .archive-intro{margin-top:6px;margin-bottom:11px}
}
@media(prefers-reduced-motion:reduce){.intro-leaf,.poster-copy,.poster-button{transition:none!important}}
/* An uninterrupted painting before entry; the join only appears as doors move. */
.intro-leaf-left::after,.intro-leaf-right::after{opacity:0;transition:opacity .13s ease}
.new-intro.opening .intro-leaf-left::after,.new-intro.opening .intro-leaf-right::after{opacity:1}

</style>
</head>
<body>
<main id="experience">
  <!-- Ink-wash paper panels: two actual halves of the same illustration -->
  <section id="arrival" class="arrival new-intro" aria-label="강호십존 첫 화면">
  <div class="intro-stage">
    <div class="intro-side intro-side-left" aria-hidden="true"></div>
    <div class="intro-portal">
      <div class="poster-doors" aria-hidden="true">
        <div class="intro-leaf intro-leaf-left"><div class="leaf-paper"></div><div class="leaf-paint"></div></div>
        <div class="intro-leaf intro-leaf-right"><div class="leaf-paper"></div><div class="leaf-paint"></div></div>
      </div>
      <div class="poster-copy" id="introContent">
        <div class="poster-heading">
          <div class="poster-overline">南宋 · 1265</div>
          <h1>강호십존</h1>
          <div class="poster-hanzi">江湖十尊 <span class="poster-seal" aria-label="기록">錄</span></div>
          <p class="poster-subtitle">천하에 남겨진 열 사람의 기록.</p>
        </div>
        <div class="poster-bottom">
          <button id="enter" type="button" class="poster-button"><span aria-hidden="true">✦</span>입장하기<span aria-hidden="true">✦</span></button>
          <div class="poster-smallprint">天下十尊錄 · 江湖의 기록</div>
        </div>
      </div>
    </div>
    <div class="intro-side intro-side-right" aria-hidden="true"></div>
  </div>
  <button id="introSound" type="button" class="intro-audio" aria-label="배경음악 켜기 또는 끄기" aria-pressed="true">♫ <span>음악 켜짐</span></button>
  <button id="skipEntry" type="button" class="skip-entry" hidden aria-hidden="true" tabindex="-1">연출 건너뛰기</button>
</section>

  <section id="library" class="library" aria-label="천하십존록 장서각" inert>
    <div class="library-art" aria-hidden="true"></div>
    <div class="library-shade" aria-hidden="true"></div>
    <div class="archive-shell">
      <header class="archive-topbar">
        <div class="archive-logo"><span class="logo-mark">十</span><div><strong>강호십존</strong><small>江湖十尊 · 1265</small></div></div>
        <div class="archive-top-actions"><span class="archive-locale">南宋 · 咸淳元年</span><button id="musicBtn" class="tool-button" type="button" aria-pressed="true">♫ 음악</button><button id="sfxBtn" class="tool-button" type="button" aria-pressed="true">효과음</button><button id="replayBtn" class="tool-button" type="button">↺ <span>입장 다시 보기</span></button></div>
      </header>
      <div class="archive-plaque" aria-hidden="true">장서각<small>藏 書 閣</small></div>
  <div class="archive-intro"><div class="archive-kicker">THE TEN MASTERS OF JIANGHU <span>／</span> 天下十尊錄</div><h1>십존의 기록<span class="heading-red">.</span></h1><p>천하에 이름을 남긴 열 사람. 그 풍문과 전적을 담다.</p></div>
      <div class="archive-collection">
        <div class="collection-head"><span>01 <i></i> PERSONNEL ARCHIVE</span><span class="collection-note">열람할 기록을 선택하세요</span></div>
        <div id="recordGrid" class="record-grid" aria-label="십존 10명 기록 선택"></div>
        <div class="collection-foot"><span>全十卷 · 총 열 권</span><span>서열은 강호 풍문과 전적에 따른 비공식적 평가입니다.</span></div>
      </div>
      <footer class="archive-footer"><span>江湖十尊 · @Kopite</span><a target="_blank" rel="noopener noreferrer" href="https://zeta-ai.io/ko/plots/3b0e84b9-3e6b-41eb-a1a3-3fd9580ce46b/profile?share_id=8urrtc30f">제타에서 이야기 시작하기 <span aria-hidden="true">↗</span></a></footer>
    </div>
  </section>

  <div id="recordLayer" class="record-layer" aria-hidden="true" inert>
    <div class="record-veil" id="recordVeil"></div>
    <section class="floating-record" id="floatingRecord" role="dialog" aria-modal="true" aria-labelledby="personName" tabindex="-1">
      <div class="floating-closed" id="floatingClosed" aria-hidden="true"><span class="closed-shaft"></span><span class="closed-silk"></span><span class="closed-seam"></span></div>
      <div class="paper-window" id="paperWindow">
        <div class="sheet-content" id="sheetContent">
          <div class="portrait-side">
            <div class="portrait-container"><img id="personArt" alt=""><button type="button" id="imageZoom" class="art-view">원본 보기 <span aria-hidden="true">↗</span></button></div>
            <div class="portrait-credit">江湖十尊 · 人物圖錄 <span id="photoRank">第一席</span></div>
          </div>
          <div class="person-detail" id="personDetail">
            <div class="detail-topline"><span>人物錄 · CHARACTER RECORD</span><span id="personOrdinal">卷之一</span></div>
            <div class="rank-line" id="personRank">第一席</div>
            <div class="person-title"><h2 id="personName">탁라현</h2><div class="person-aka" id="personAka">혈마 · 血魔</div></div>
            <div class="person-facts">
              <div><span>나이</span><strong id="personAge">65세</strong></div>
              <div><span>경지</span><strong id="personRealm">생사경</strong></div>
              <div class="fact-full"><span>신분 · 소속</span><strong id="personFaction">혈교 제11대 교주</strong></div>
              <div><span>병기</span><strong id="personWeapon">없음</strong></div>
              <div><span>성정</span><strong id="personTemper">느긋하고 초연함</strong></div>
            </div>
            <section class="detail-section"><h3>인물 개요</h3><p id="personSummary"></p></section>
            <section class="detail-section speciality"><h3>대표 무공</h3><strong id="personSkill"></strong><p id="personSkillDesc"></p></section>
            <details id="artsDetail" class="arts-detail"><summary>그 밖의 무학 <span aria-hidden="true">＋</span></summary><div id="personArts"></div></details>
          </div>
        </div>
      </div>
      <div class="roll-axis axis-left" id="axisLeft" aria-hidden="true"></div>
      <div class="roll-axis axis-right" id="axisRight" aria-hidden="true"></div>
      <button id="recordClose" type="button" class="record-close" aria-label="두루마리 닫기"><span aria-hidden="true">×</span></button>
      <div class="record-controls"><button id="personPrev" type="button">← 이전 기록</button><span id="personCounter">01 / 10</span><button id="personNext" type="button">다음 기록 →</button></div>
    </section>
  </div>
  <div id="zoomLayer" class="zoom-layer" hidden><button id="zoomClose" type="button" aria-label="확대 이미지 닫기">닫기 ×</button><img id="zoomImage" alt=""></div>
  <audio id="theme" src="data:audio/mpeg;base64," loop preload="none"></audio>
</main>
<script>window.SIPJON_PEOPLE = [{"rank":1,"name":"탁라현","alias":"혈마","age":65,"faction":"혈교 제11대 교주","realm":"생사경","summary":"삶과 죽음을 하나의 흐름으로 여기는 혈교의 교주. 혈기와 천지지기를 순환시켜 넓은 전장을 자신의 영역으로 바꾼다.","special":"혈옥천라진","focus":"피와 천지지기로 광대한 진세를 펼쳐 상대의 움직임과 운공을 짓누른다.","temper":"느긋하고 초연한 생사관","accent":"#98382d","portrait":"data:image/webp;base64,","arts":"혈하귀원공 · 혈옥천라진 · 역혈쇄맥수 · 혈하도천"},{"rank":2,"name":"천현월","alias":"천마","age":45,"faction":"천마신교 제20대 교주","realm":"현경 극","summary":"만사를 귀찮아하면서도 강호십존 2위에는 불만이 많은 천마. 병기 없이 마기와 육신만으로 상대를 압도한다.","special":"대천마수","focus":"손짓 하나로 막대한 마기를 일으키며, 근거리에서는 불멸마체로 맞붙는다.","temper":"나른하고 거침없는 승부욕","accent":"#83353b","portrait":"data:image/webp;base64,","arts":"천마신공 · 대천마수 · 허천보 · 불멸마체"},{"rank":3,"name":"남궁진악","alias":"창천검","age":65,"faction":"남궁세가 가주 · 무림맹주","realm":"현경 완숙","summary":"남궁세가 가주이자 무림맹주. 푸른 검세로 전장을 뒤덮어 상대의 퇴로를 막고 정면에서 압도한다.","special":"창궁무애검법","focus":"정대한 검로와 강대한 검강으로 상대의 초식을 정면에서 밀어 부순다.","temper":"진중함 속에 숨은 유머","accent":"#326b7a","portrait":"data:image/webp;base64,","arts":"창궁대연신공 · 창궁무애검법 · 천리호정 · 창궁강기"},{"rank":4,"name":"담여진","alias":"공명객","age":48,"faction":"방외지인","realm":"현경 완숙","summary":"태어날 때부터 앞을 볼 수 없지만 세상의 울림을 읽는 방외의 고수. 명철간의 공명으로 상대와 지형의 떨림에 간섭한다.","special":"천음십이식","focus":"철간을 통해 전해지는 진동을 겹쳐 움직임과 균형을 흐트러뜨린다.","temper":"온화하고 세심한 관찰자","accent":"#607a73","portrait":"data:image/webp;base64,","arts":"공명진기 · 천음십이식 · 진영보 · 회진공"},{"rank":5,"name":"현각","alias":"뇌음","age":56,"faction":"포달랍궁 법왕","realm":"현경 완숙","summary":"서장의 포달랍궁을 이끄는 법왕. 구환선장의 무게와 천둥 같은 진언으로 적을 압박하는 육중한 무인이다.","special":"천뢰진언","focus":"내공을 실은 진언의 울림으로 상대의 호흡과 기혈을 흔든다.","temper":"과묵하지만 불같은 성정","accent":"#8a6741","portrait":"data:image/webp;base64,","arts":"금륜심법 · 금강복마장 · 천뢰진언 · 부동금강신"},{"rank":6,"name":"위소연","alias":"이척","age":52,"faction":"사도련주","realm":"현경 초입","summary":"흑도와 사파의 연합체 사도련을 이끄는 련주. 장검과 단검의 길이 차이를 이용해 상대의 거리 감각을 무너뜨린다.","special":"음양무간","focus":"두 검의 서로 다른 간격으로 닿을 듯 닿지 않는 기묘한 검로를 만든다.","temper":"냉정하고 단호한 결단","accent":"#68476f","portrait":"data:image/webp;base64,","arts":"유맥심법 · 음양무간 · 무정보 · 편류공"},{"rank":7,"name":"청화","alias":"한매","age":44,"faction":"화산파 일대제자","realm":"현경 초입","summary":"화산파를 대표하는 낭만적인 검객. 빠르고 화려하며 변화무쌍한 매화검을 펼친다.","special":"이십사수매화검법","focus":"매화처럼 연이어 변화하는 검초로 상대의 빈틈을 파고든다.","temper":"낙천적이고 자유분방함","accent":"#9f5563","portrait":"data:image/webp;base64,","arts":"자하신공 · 이십사수매화검법 · 오행매화보 · 자하강기"},{"rank":8,"name":"정현","alias":"북진자","age":50,"faction":"종남파 장문인","realm":"현경 초입","summary":"전통과 규율을 중시하는 종남파 장문인. 묵직하고 빈틈없는 검술을 추구하며 화산파의 한매를 강하게 의식한다.","special":"천하삼십육검","focus":"기본기와 정제된 검로를 바탕으로 방어의 빈틈을 좁힌다.","temper":"엄격하고 지기 싫어하는 성정","accent":"#5b697d","portrait":"data:image/webp;base64,","arts":"북두심법 · 천하삼십육검 · 칠성보 · 북두강기"},{"rank":9,"name":"단휘랑","alias":"일선","age":53,"faction":"서량 단가 가주","realm":"화경 극","summary":"기교를 버리고 오직 한 번의 찌르기를 극한까지 연마한 서량 단가 가주. 모든 힘을 창끝 한 점에 집중한다.","special":"관일창","focus":"가장 짧은 직선으로 내지르는 한 수가 수십 년의 수행 끝에 절기가 되었다.","temper":"호쾌하고 뒤끝 없는 승부광","accent":"#916346","portrait":"data:image/webp;base64,","arts":"귀원심법 · 관일창 · 비성보 · 절류공"},{"rank":10,"name":"임청악","alias":"무흔","age":62,"faction":"점창파 전대 장문인","realm":"화경 극","summary":"점창파 전대 장문인. 발검과 납검의 흔적조차 보이지 않는 쾌검의 달인이며 십존의 서열에는 개의치 않는다.","special":"분광검법","focus":"수많은 검광과 잔영 속에서 눈으로 쫓기 어려운 쾌검을 펼친다.","temper":"느긋하고 기본기에 까다로움","accent":"#4a757c","portrait":"data:image/webp;base64,","arts":"창운심법 · 분광검법 · 추풍보 · 회류공"}];
</script>
<script>(() => {
'use strict';
const people=window.SIPJON_PEOPLE;
if(!Array.isArray(people)||people.length!==10)throw Error('강호십존은 정확히 열 명이어야 합니다.');
const $=id=>document.getElementById(id);
const numerals=['一','二','三','四','五','六','七','八','九','十'];
const cnAlias=['血魔','天魔','蒼天劍','共鳴客','雷音','異尺','寒梅','北辰子','一線','無痕'];
const weapons=['없음','없음','검','명철간','구환선장','장검 · 단검','검','검','장창','검'];
const clamp=v=>Math.max(0,Math.min(1,v));
const smooth=v=>{v=clamp(v);return v*v*(3-2*v)};
const mix=(a,b,t)=>a+(b-a)*t;
const sleep=t=>new Promise(resolve=>setTimeout(resolve,t));
const reduce=()=>window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const mobile=()=>window.innerWidth<=820;
const music=$('theme');music.volume=0;
const layer=$('recordLayer'),sheet=$('floatingRecord'),paper=$('paperWindow'),axis=$('axisRight'),library=$('library');
let scene='gate',chosen=null,active=0,busy=false,entryFrame=0,entryStart=0,audioCtx=null;
let musicEnabled=true,sfxEnabled=true,originScroll=0;
try{const mute=localStorage.getItem('sipjon-music');if(mute!==null)musicEnabled=mute==='true';const effects=localStorage.getItem('sipjon-sfx');if(effects!==null)sfxEnabled=effects==='true'}catch{}
const save=()=>{try{localStorage.setItem('sipjon-music',String(musicEnabled));localStorage.setItem('sipjon-sfx',String(sfxEnabled))}catch{}};
function updateMusicButtons(){const b=$('musicBtn'),s=$('sfxBtn');b.textContent=musicEnabled?'♫ 음악 켜짐':'♪ 음악 꺼짐';b.setAttribute('aria-pressed',String(musicEnabled));s.textContent=sfxEnabled?'효과음 켜짐':'효과음 꺼짐';s.setAttribute('aria-pressed',String(sfxEnabled));const ib=$('introSound');if(ib){ib.setAttribute('aria-pressed',String(musicEnabled));ib.querySelector('span').textContent=musicEnabled?'음악 켜짐':'음악 꺼짐'}}
updateMusicButtons();
function sound(kind){if(!sfxEnabled)return;try{audioCtx??=new (AudioContext||webkitAudioContext)();if(audioCtx.state==='suspended')audioCtx.resume();const duration=kind==='door'?.65:kind==='paper'?.22:.10;const audio=audioCtx;const buffer=audio.createBuffer(1,Math.round(audio.sampleRate*duration),audio.sampleRate);const d=buffer.getChannelData(0);for(let j=0;j<d.length;j++)d[j]=(Math.random()*2-1)*Math.pow(1-j/d.length,kind==='door'?1.6:2.7);const source=audio.createBufferSource(),filter=audio.createBiquadFilter(),gain=audio.createGain();source.buffer=buffer;filter.type='lowpass';filter.frequency.value=kind==='door'?280:kind==='paper'?700:420;gain.gain.value=kind==='door'?.060:kind==='paper'?.016:.012;source.connect(filter);filter.connect(gain);gain.connect(audio.destination);source.start()}catch{}}
function startMusic(){if(!musicEnabled)return;music.volume=0;music.play().then(()=>{const from=performance.now();const loop=now=>{if(music.paused||!musicEnabled)return;const t=smooth((now-from)/1600);music.volume=.25*t;if(t<1)requestAnimationFrame(loop)};requestAnimationFrame(loop)}).catch(()=>{})}
function pauseMusic(){music.pause()}

// All ten tangible manuscript buttons are created from the same immutable character list.
const grid=$('recordGrid');
people.forEach((person,i)=>{
 const b=document.createElement('button');b.type='button';b.className='roll-slot';b.dataset.rank=String(i+1);b.setAttribute('aria-label',`제${i+1}석 ${person.alias} ${person.name}, 기록 펼치기`);
 b.innerHTML=`<span class="roll-index">第${numerals[i]}席</span><span class="roll-visual" aria-hidden="true"><span class="roll-shaft"></span><span class="roll-silk"></span><span class="roll-edge top"></span><span class="roll-edge bottom"></span></span><span class="roll-caption"><strong>${person.alias}</strong><small>${person.name}</small></span>`;
 b.addEventListener('click',()=>openPerson(i,b));grid.appendChild(b)
});

// A single, literal sliding-door transition; no courtyard or interior journey.
let entryTimer=0;
function reachArchive(){
 if(scene==='archive')return;
 scene='archive';clearTimeout(entryTimer);cancelAnimationFrame(entryFrame);
 library.classList.add('visible','entry-ready');library.removeAttribute('inert');
 $('arrival').hidden=true;$('skipEntry').hidden=true;
 $('arrival').classList.remove('opening');
 const heading=library.querySelector('.archive-intro h1');
 if(heading){heading.setAttribute('tabindex','-1');heading.focus({preventScroll:true})}
}
function enter(){
 if(scene!=='gate')return;
 scene='entering';$('enter').disabled=true;
 library.classList.add('visible','entry-ready'); // Render the ten scrolls directly behind the paper.
 $('skipEntry').hidden=true;
 startMusic();sound('door');
 if(reduce()){reachArchive();return}
 // Start the physical panels on the next paint; no intermediary scenes.
 requestAnimationFrame(()=>{if(scene!=='entering')return;$('arrival').classList.add('opening')});
 entryTimer=setTimeout(reachArchive,980);
}
function resetEntry(){
 if(busy)return;
 clearTimeout(entryTimer);cancelAnimationFrame(entryFrame);
 $('arrival').hidden=false;$('arrival').classList.remove('opening','leaving');
 $('enter').disabled=false;$('skipEntry').hidden=true;
 library.classList.remove('visible','entry-ready');library.setAttribute('inert','');
 scene='gate';$('enter').focus({preventScroll:true});
}
function fillPerson(i){active=(i+people.length)%people.length;const p=people[active];$('personArt').src=p.portrait;$('personArt').alt=`${p.name}(${p.alias}) 원본 일러스트`;$('personOrdinal').textContent=`卷之${numerals[active]}`;$('photoRank').textContent=`第${numerals[active]}席`;$('personRank').textContent=`第${numerals[active]}席 · 강호십존`;$('personName').textContent=p.name;$('personAka').textContent=`${p.alias} · ${cnAlias[active]}`;$('personAge').textContent=p.age+'세';$('personRealm').textContent=p.realm;$('personFaction').textContent=p.faction;$('personWeapon').textContent=weapons[active];$('personTemper').textContent=p.temper;$('personSummary').textContent=p.summary;$('personSkill').textContent=p.special;$('personSkillDesc').textContent=p.focus;$('personArts').textContent=p.arts;$('personCounter').textContent=`${String(active+1).padStart(2,'0')} / 10`;$('artsDetail').open=false;$('personDetail').scrollTop=0;layer.scrollTop=0;sheet.style.setProperty('--record-accent',p.accent||'#a46550');}
function geometry(){const W=window.innerWidth,H=window.innerHeight,m=mobile(),width=Math.min(1160,W-(m?20:48));const height=m?Math.max(H-22,W<=390?1280:1220):Math.min(790,H-50);return{left:(W-width)/2,top:m?14:(H-height)/2,width,height,paper:width-34,rod:width-25,m}};
function setRect(b){Object.assign(sheet.style,{left:b.left+'px',top:b.top+'px',width:b.width+'px',height:b.height+'px'})}
async function animateEl(el,frames,options){const animation=el.animate(frames,options);try{await animation.finished}catch{}animation.cancel()}
async function openPerson(index,source){if(scene!=='archive'||busy||layer.classList.contains('active'))return;busy=true;chosen=source;originScroll=library.scrollTop;fillPerson(index);const roll=source.querySelector('.roll-visual').getBoundingClientRect();const base={left:roll.left,top:roll.top,width:roll.width,height:roll.height};const g=geometry();source.classList.add('is-selected');source.setAttribute('aria-current','true');layer.removeAttribute('inert');layer.setAttribute('aria-hidden','false');layer.classList.add('active');library.setAttribute('inert','');library.style.overflow='hidden';sheet.className='floating-record';paper.style.width='0px';axis.style.transform='translateX(0px)';sheet.style.setProperty('--inner-width',g.paper+'px');setRect(base);$('recordClose').style.visibility='hidden';
 // The selected physical roll travels from its actual DOM rectangle to the future left edge.
 const destination={left:g.left,top:g.top,width:45,height:g.height};
 if(!reduce())await animateEl(sheet,[base,destination].map(x=>({left:x.left+'px',top:x.top+'px',width:x.width+'px',height:x.height+'px'})),{duration:340,easing:'cubic-bezier(.2,.8,.2,1)',fill:'both'});
 setRect(destination);sheet.style.setProperty('--height',g.height+'px');sheet.classList.add('unrolling');
 // The left spindle remains fixed. The right spindle moves; paper is revealed, never stretched.
 sheet.style.width=g.width+'px';
 if(!reduce())await Promise.all([animateEl(paper,[{width:'0px'},{width:g.paper+'px'}],{duration:690,easing:'cubic-bezier(.2,.72,.25,1)',fill:'both'}),animateEl(axis,[{transform:'translateX(0px)'},{transform:`translateX(${g.rod}px)`}],{duration:690,easing:'cubic-bezier(.2,.72,.25,1)',fill:'both'})]);
 paper.style.width=g.paper+'px';axis.style.transform=`translateX(${g.rod}px)`;sheet.classList.add('opened','content-visible');$('recordClose').style.visibility='visible';sound('paper');busy=false;$('recordClose').focus({preventScroll:true});}
async function closePerson(force=false){if(!layer.classList.contains('active'))return;if(busy&&!force)return;busy=true;hideZoom();const g=geometry(),source=chosen;sheet.classList.remove('content-visible');$('recordClose').style.visibility='hidden';if(!reduce()&&!force)await sleep(110);
 if(!reduce()&&!force)await Promise.all([animateEl(paper,[{width:g.paper+'px'},{width:'0px'}],{duration:380,easing:'ease-in',fill:'both'}),animateEl(axis,[{transform:`translateX(${g.rod}px)`},{transform:'translateX(0px)'}],{duration:380,easing:'ease-in',fill:'both'})]);
 paper.style.width='0px';axis.style.transform='translateX(0px)';sheet.classList.remove('unrolling','opened');const rect=source?.querySelector('.roll-visual')?.getBoundingClientRect();const b=sheet.getBoundingClientRect();const target=rect?{left:rect.left,top:rect.top,width:rect.width,height:rect.height}:null;
 if(!reduce()&&!force&&target)await animateEl(sheet,[{left:b.left+'px',top:b.top+'px',width:45+'px',height:b.height+'px'},{left:target.left+'px',top:target.top+'px',width:target.width+'px',height:target.height+'px'}],{duration:270,easing:'ease-in-out',fill:'both'});
 layer.classList.remove('active');layer.setAttribute('inert','');layer.setAttribute('aria-hidden','true');library.removeAttribute('inert');library.style.overflow='';library.scrollTop=originScroll;source?.classList.remove('is-selected');source?.removeAttribute('aria-current');chosen=null;sheet.className='floating-record';sheet.removeAttribute('style');busy=false;if(!force&&source?.isConnected)source.focus({preventScroll:true});}
async function turnPerson(delta){if(busy||!layer.classList.contains('active'))return;busy=true;sheet.classList.remove('content-visible');if(!reduce())await sleep(160);fillPerson(active+delta);sheet.classList.add('content-visible');sound('paper');if(!reduce())await sleep(180);busy=false}
function showZoom(){if(!layer.classList.contains('active'))return;$('zoomImage').src=people[active].portrait;$('zoomImage').alt=`${people[active].name} 원본 이미지`;$('zoomLayer').hidden=false;$('zoomClose').focus()}
function hideZoom(){if(!$('zoomLayer').hidden){$('zoomLayer').hidden=true;$('imageZoom').focus({preventScroll:true})}}
$('enter').addEventListener('click',enter);$('introSound').addEventListener('click',()=>{musicEnabled=!musicEnabled;if(!musicEnabled)pauseMusic();updateMusicButtons();save()});$('skipEntry').addEventListener('click',reachArchive);$('replayBtn').addEventListener('click',resetEntry);
$('musicBtn').addEventListener('click',()=>{musicEnabled=!musicEnabled;if(musicEnabled){music.volume=.25;music.play().catch(()=>{})}else pauseMusic();updateMusicButtons();save()});
$('sfxBtn').addEventListener('click',()=>{sfxEnabled=!sfxEnabled;updateMusicButtons();save()});
$('recordClose').addEventListener('click',()=>closePerson());$('recordVeil').addEventListener('click',()=>closePerson());$('personPrev').addEventListener('click',()=>turnPerson(-1));$('personNext').addEventListener('click',()=>turnPerson(1));$('imageZoom').addEventListener('click',showZoom);$('zoomClose').addEventListener('click',hideZoom);$('zoomLayer').addEventListener('click',e=>{if(e.target===$('zoomLayer'))hideZoom()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!$('zoomLayer').hidden){hideZoom();return}closePerson();return}if(!layer.classList.contains('active')||!$('zoomLayer').hidden)return;if(e.key==='ArrowLeft'){e.preventDefault();turnPerson(-1)}if(e.key==='ArrowRight'){e.preventDefault();turnPerson(1)}if(e.key==='Tab'){const focusables=[...sheet.querySelectorAll('button,summary')].filter(el=>el.offsetParent!==null&&getComputedStyle(el).visibility!=='hidden');if(!focusables.length)return;const f=focusables[0],l=focusables.at(-1);if(e.shiftKey&&document.activeElement===f){e.preventDefault();l.focus()}else if(!e.shiftKey&&document.activeElement===l){e.preventDefault();f.focus()}}});
window.addEventListener('resize',()=>{if(!layer.classList.contains('active')||busy)return;const g=geometry();setRect(g);sheet.style.setProperty('--inner-width',g.paper+'px');paper.style.width=g.paper+'px';axis.style.transform=`translateX(${g.rod}px)`});
window.__JIANGHU_TEST={reachArchive,enter,openPerson,closePerson,turnPerson,geometry,getStatus:()=>({scene,active,busy,count:grid.children.length,open:layer.classList.contains('active')}),people};
})();
</script>
</body></html>
